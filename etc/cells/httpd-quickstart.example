# quickstart for the historical cellman httpd sample on celladm\n#\n# 1) create payload dir on host\n#    mkdir -p /var/www/httpd\n#    cp /usr/share/examples/cellman/httpd/assets/index.html /var/www/httpd/index.html\n#\n# 2) install cell config\n#    cp /etc/cells/cells.d/httpd.cell.example /etc/cells/cells.d/httpd.cell\n#\n# 3) adjust root_base in /etc/cells/cells.d/httpd.cell if needed\n#\n# 4) generate and start\n#    celladm validate\n#    celladm generate\n#    service cell_httpd start\n#\n# 5) test\n#    ftp -o - http://127.0.0.1:8080/\n