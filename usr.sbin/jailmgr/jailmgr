#!/bin/sh
#
# Build and manage IP-bound jailctl jails with a shared read-only base layer.
#
# Layout:
#   /var/jailmgr/releases/<release>/<arch>/{base,etc}.tar.xz
#   /var/jailmgr/base/<release>-<arch>/
#   /var/jailmgr/jails/<name>/{root,etc,var,tmp,home}
#
# Config:
#   /etc/jailmgr.conf
#
# Requires root, jailctl, tar, and mount_null.

set -eu

PATH=/sbin:/bin:/usr/sbin:/usr/bin

CONF_FILE=${JAILMGR_CONF:-/etc/jailmgr.conf}

RELEASE=10.0
MACHINE_ARCH=$(uname -m)
NETBSD_MIRROR=
JAIL_BASE_DIR=/var/jailmgr/base
JAIL_DATA_DIR=/var/jailmgr/jails
JAIL_RELEASE_DIR=/var/jailmgr/releases
JAIL_DEFAULT_USER=user
# Required command (with args) to supervise inside each jail, e.g. "/bin/sh /etc/rc"
JAIL_SUPERVISE_CMD=

# Per-jail local /dev setup.
JAIL_LOCAL_DEV=YES
JAIL_DEV_SIZE=8m
JAIL_DEVICES="std ptm"

# Host-side alias interface for jail bind IPs.
JAIL_HOST_IF=lo0

# Optional NPF port-forwarding support.
NPF_ENABLE=NO
NPF_EXT_IF=
NPF_CONF_SNIPPET=/etc/npf-jailmgr.conf
NPF_AUTO_RELOAD=NO
# Format: "name:host_port:jail_port name2:host_port:jail_port"
NPF_RDR_LIST=

if [ -r "${CONF_FILE}" ]; then
	# shellcheck disable=SC1090
	. "${CONF_FILE}"
fi

if [ -z "${NETBSD_MIRROR}" ]; then
	NETBSD_MIRROR="https://cdn.netbsd.org/pub/NetBSD/NetBSD-${RELEASE}/${MACHINE_ARCH}/binary/sets"
fi

BASE_LAYER="${JAIL_BASE_DIR}/${RELEASE}-${MACHINE_ARCH}"
SET_DIR="${JAIL_RELEASE_DIR}/${RELEASE}/${MACHINE_ARCH}"
BASE_SET="${SET_DIR}/base.tar.xz"
ETC_SET="${SET_DIR}/etc.tar.xz"

usage() {
	cat <<USAGE
Usage: $0 <command> [args]

Commands:
  bootstrap                      Download sets and build shared base layer
  prepare <name> <ip>            Create jail instance directories and persist jail.conf
  host-net-up                    Add host aliases (default on JAIL_HOST_IF=lo0) for all jail IPs
  host-net-down                  Remove host aliases for all jail IPs
  start <name> [ip]              Mount jail root and supervise jail via jailctl
  start --all                    Alias host IPs and start all configured jails
  stop <name>                    Gracefully stop one jail, then destroy and unmount root
  stop --all                     Stop all configured jails
  npf-sync                       Generate/update NPF rdr snippet from NPF_RDR_LIST
  status                         Show jailctl list and mount status
  gen-rc [/etc/rc.d/jailmgr]    Emit rc.d wrapper script

Each jail stores its own config at: ${JAIL_DATA_DIR}/<name>/jail.conf
NPF_RDR_LIST format: "name:2221:22 name2:2222:22"
JAIL_SUPERVISE_CMD format: "/path/to/cmd arg1 arg2" (required)
USAGE
}

need_root() {
	if [ "$(id -u)" -ne 0 ]; then
		echo "must be root" >&2
		exit 1
	fi
}

require_tools() {
	for t in jailctl tar mount mount_tmpfs umount ifconfig ps; do
		command -v "${t}" >/dev/null 2>&1 || {
			echo "missing required tool: ${t}" >&2
			exit 1
		}
	done
}

jail_pids() {
	jid=$1
	ps -axo pid=,jid= | awk -v j="${jid}" '$2==j{print $1}'
}

jail_monitor_pid() {
	name=$1
	jid=$2
	ps -axo pid=,command= | awk -v n="${name}" -v j="${jid}" '
		$0 ~ "jailctl supervise jail=" n " jid=" j { print $1; exit }
	'
}

stop_jail_processes() {
	name=$1
	jid=$2
	monitor_pid=$(jail_monitor_pid "${name}" "${jid}" || true)

	# Best effort inside-jail shutdown hook.
	jailctl exec "${jid}" /bin/sh -c 'if [ -x /etc/rc.shutdown ]; then /etc/rc.shutdown; fi' >/dev/null 2>&1 || true

	for sig in TERM KILL; do
		pids=$(jail_pids "${jid}" | tr '\n' ' ')
		[ -n "${pids}" ] || break
		# shellcheck disable=SC2086
		kill -${sig} ${pids} >/dev/null 2>&1 || true
		for _ in 1 2 3 4 5; do
			sleep 1
			pids=$(jail_pids "${jid}" | tr '\n' ' ')
			[ -z "${pids}" ] && break
		done
	done

	if [ -n "${monitor_pid}" ]; then
		kill -TERM "${monitor_pid}" >/dev/null 2>&1 || true
		sleep 1
		kill -KILL "${monitor_pid}" >/dev/null 2>&1 || true
	fi
}

fetch_sets() {
	need_root
	require_tools
	mkdir -p "${SET_DIR}"

	fetch_url="${NETBSD_MIRROR%/}"

	if command -v ftp >/dev/null 2>&1; then
		ftp -V -o "${BASE_SET}" "${fetch_url}/base.tar.xz"
		ftp -V -o "${ETC_SET}" "${fetch_url}/etc.tar.xz"
	elif command -v curl >/dev/null 2>&1; then
		curl -fL -o "${BASE_SET}" "${fetch_url}/base.tar.xz"
		curl -fL -o "${ETC_SET}" "${fetch_url}/etc.tar.xz"
	else
		echo "need ftp(1) or curl to fetch sets" >&2
		exit 1
	fi

	echo "Downloaded sets to ${SET_DIR}"
}

build_base() {
	need_root
	require_tools
	[ -f "${BASE_SET}" ] || {
		echo "missing ${BASE_SET}; run bootstrap first" >&2
		exit 1
	}

	mkdir -p "${BASE_LAYER}"
	tar -xzp -f "${BASE_SET}" -C "${BASE_LAYER}"
	echo "Prepared base layer at ${BASE_LAYER}"
}

jail_paths() {
	name=$1
	JAIL_DIR="${JAIL_DATA_DIR}/${name}"
	ROOT_DIR="${JAIL_DIR}/root"
	ETC_DIR="${JAIL_DIR}/etc"
	VAR_DIR="${JAIL_DIR}/var"
	TMP_DIR="${JAIL_DIR}/tmp"
	HOME_DIR="${JAIL_DIR}/home"
	DEV_DIR="${JAIL_DIR}/dev"
	JAIL_CONF="${JAIL_DIR}/jail.conf"
}

load_jail_conf() {
	name=$1
	jail_paths "${name}"
	if [ ! -r "${JAIL_CONF}" ]; then
		echo "missing ${JAIL_CONF}; run prepare ${name} <ip> first" >&2
		exit 1
	fi

	JAIL_NAME=
	JAIL_IPV4=
	JAIL_SUPERVISE_CMD_LOCAL=
	# shellcheck disable=SC1090
	. "${JAIL_CONF}"

	if [ -z "${JAIL_NAME:-}" ]; then
		JAIL_NAME=${name}
	fi
	if [ "${JAIL_NAME}" != "${name}" ]; then
		echo "jail.conf mismatch: expected JAIL_NAME=${name}, got ${JAIL_NAME}" >&2
		exit 1
	fi
	if [ -z "${JAIL_IPV4:-}" ]; then
		echo "JAIL_IPV4 missing in ${JAIL_CONF}" >&2
		exit 1
	fi
}

for_each_jail_conf() {
	action=$1
	for jail_conf in "${JAIL_DATA_DIR}"/*/jail.conf; do
		[ -f "${jail_conf}" ] || continue
		name=${jail_conf%/jail.conf}
		name=${name##*/}
		"${action}" "${name}"
	done
}

setup_local_dev() {
	if [ "${JAIL_LOCAL_DEV}" != "YES" ]; then
		return
	fi

	mkdir -p "${ROOT_DIR}/dev"
	if ! mount | awk -v p="on ${ROOT_DIR}/dev " 'index($0,p){found=1} END{exit !found}'; then
		mount_tmpfs -s "${JAIL_DEV_SIZE}" tmpfs "${ROOT_DIR}/dev"
	fi

	if [ -f "${ROOT_DIR}/dev/MAKEDEV" ]; then
		:
	elif [ -f /dev/MAKEDEV ]; then
		cp /dev/MAKEDEV "${ROOT_DIR}/dev/MAKEDEV"
		chmod 555 "${ROOT_DIR}/dev/MAKEDEV"
	else
		echo "warning: MAKEDEV not found; skipping /dev node creation" >&2
		return
	fi

	# shellcheck disable=SC2086
	(cd "${ROOT_DIR}/dev" && sh ./MAKEDEV ${JAIL_DEVICES})
}

setup_etc() {
	[ -f "${ETC_SET}" ] || {
		echo "missing ${ETC_SET}; run bootstrap first" >&2
		exit 1
	}

	if [ ! -f "${ETC_DIR}/rc.conf" ]; then
		tar -xzp -f "${ETC_SET}" -C "${JAIL_DIR}"
	fi


	mkdir -p "${ETC_DIR}/ssh"

	grep -q '^sshd=YES' "${ETC_DIR}/rc.conf" 2>/dev/null ||
		echo 'sshd=YES' >> "${ETC_DIR}/rc.conf"

	grep -q '^hostname=' "${ETC_DIR}/rc.conf" 2>/dev/null ||
		echo "hostname=${name}" >> "${ETC_DIR}/rc.conf"

	if [ ! -f "${ETC_DIR}/master.passwd" ]; then
		echo "warning: ${ETC_DIR}/master.passwd not found; user provisioning skipped" >&2
		return
	fi

	if [ -z "${JAIL_DEFAULT_USER}" ]; then
		return
	fi

	if ! awk -F: -v u="${JAIL_DEFAULT_USER}" '$1==u{found=1} END{exit !found}' "${ETC_DIR}/master.passwd"; then
		echo "${JAIL_DEFAULT_USER}:*:1000:1000::0:0:Jail User:/home/${JAIL_DEFAULT_USER}:/bin/ksh" >> "${ETC_DIR}/master.passwd"
		pwd_mkdb -d "${ETC_DIR}" master.passwd
	fi
}

mount_jail_root() {
	# Ensure mount targets exist in the base layer before mounting it read-only.
	mkdir -p "${BASE_LAYER}/home"

	if mount | awk -v p="on ${ROOT_DIR} " 'index($0,p){found=1} END{exit !found}'; then
		return
	fi

	mount -t null -o ro "${BASE_LAYER}" "${ROOT_DIR}"
	mount -t null "${ETC_DIR}" "${ROOT_DIR}/etc"
	mount -t null "${VAR_DIR}" "${ROOT_DIR}/var"
	mount -t null "${TMP_DIR}" "${ROOT_DIR}/tmp"
	mount -t null "${HOME_DIR}" "${ROOT_DIR}/home"
	setup_local_dev
}

umount_jail_root() {
	for d in dev home tmp var etc ""; do
		mp="${ROOT_DIR}${d:+/$d}"
		if mount | awk -v p="on ${mp} " 'index($0,p){found=1} END{exit !found}'; then
			umount "${mp}"
		fi
	done
}

prepare_jail() {
	need_root
	require_tools
	name=$1
	ip=$2

	jail_paths "${name}"
	mkdir -p "${ROOT_DIR}" "${ETC_DIR}" "${VAR_DIR}" "${TMP_DIR}" "${HOME_DIR}" \
		"${DEV_DIR}" "${VAR_DIR}/run" "${VAR_DIR}/log"
	if [ -n "${JAIL_DEFAULT_USER}" ]; then
		mkdir -p "${HOME_DIR}/${JAIL_DEFAULT_USER}"
	fi
	chmod 1777 "${TMP_DIR}"
	setup_etc

	cat > "${JAIL_CONF}" <<CONF
# autogenerated by jailmgr
JAIL_NAME=${name}
JAIL_IPV4=${ip}
JAIL_RELEASE=${RELEASE}
JAIL_ARCH=${MACHINE_ARCH}
CONF

	echo "Prepared jail ${name} (${ip})"
}

jail_exists() {
	name=$1
	jailctl list | awk -v n="${name}" '$3==n{found=1} END{exit !found}'
}

is_alias_present() {
	ip=$1
	ifconfig "${JAIL_HOST_IF}" | awk -v ip="${ip}" '$1 == "inet" && $2 == ip { found=1 } END { exit !found }'
}

add_alias() {
	ip=$1
	if is_alias_present "${ip}"; then
		return
	fi
	ifconfig "${JAIL_HOST_IF}" alias "${ip}" netmask 255.255.255.255
}

del_alias() {
	ip=$1
	if ! is_alias_present "${ip}"; then
		return
	fi
	ifconfig "${JAIL_HOST_IF}" -alias "${ip}"
}

host_net_up() {
	need_root
	require_tools
	for_each_jail_conf host_net_up_one
	echo "Configured aliases on ${JAIL_HOST_IF}"
}

host_net_up_one() {
	name=$1
	load_jail_conf "${name}"
	add_alias "${JAIL_IPV4}"
}

host_net_down() {
	need_root
	require_tools
	for_each_jail_conf host_net_down_one
	echo "Removed aliases from ${JAIL_HOST_IF}"
}

host_net_down_one() {
	name=$1
	load_jail_conf "${name}"
	del_alias "${JAIL_IPV4}"
}

npf_sync() {
	need_root
	if [ "${NPF_ENABLE}" != "YES" ]; then
		echo "NPF_ENABLE is not YES; skipping npf sync"
		return
	fi
	if [ -z "${NPF_EXT_IF}" ]; then
		echo "NPF_EXT_IF must be set when NPF_ENABLE=YES" >&2
		exit 1
	fi

	mkdir -p "$(dirname "${NPF_CONF_SNIPPET}")"
	{
		echo "# autogenerated by jailmgr"
		echo "# include this file from /etc/npf.conf"
		for rdr in ${NPF_RDR_LIST}; do
			name=${rdr%%:*}
			rest=${rdr#*:}
			host_port=${rest%%:*}
			jail_port=${rest#*:}
			ip=$(jail_ip_by_name "${name}" || true)
			if [ -z "${ip}" ]; then
				echo "# skipped ${name}: no matching jail.conf" >&2
				continue
			fi
			echo "rdr on ${NPF_EXT_IF} proto tcp from any to (${NPF_EXT_IF}) port ${host_port} -> ${ip} port ${jail_port}"
		done
	} > "${NPF_CONF_SNIPPET}"

	echo "Wrote ${NPF_CONF_SNIPPET}"
	if [ "${NPF_AUTO_RELOAD}" = "YES" ]; then
		npfctl reload
		echo "Reloaded npf"
	fi
}

jail_ip_by_name() {
	name=$1
	jail_paths "${name}"
	if [ ! -r "${JAIL_CONF}" ]; then
		return 1
	fi
	JAIL_NAME=
	JAIL_IPV4=
	JAIL_SUPERVISE_CMD_LOCAL=
	# shellcheck disable=SC1090
	. "${JAIL_CONF}"
	if [ -z "${JAIL_IPV4:-}" ]; then
		return 1
	fi
	echo "${JAIL_IPV4}"
}

require_supervise_cmd() {
	if [ -z "${JAIL_SUPERVISE_CMD}" ]; then
		echo "JAIL_SUPERVISE_CMD must be set in ${CONF_FILE} (example: /bin/sh /etc/rc)" >&2
		exit 1
	fi
}

start_jail() {
	need_root
	require_tools
	name=$1
	ip=${2:-}

	if [ -n "${ip}" ]; then
		prepare_jail "${name}" "${ip}"
	fi
	load_jail_conf "${name}"
	ip=${JAIL_IPV4}
	if [ -n "${JAIL_SUPERVISE_CMD_LOCAL:-}" ]; then
		JAIL_SUPERVISE_CMD=${JAIL_SUPERVISE_CMD_LOCAL}
	fi

	jail_paths "${name}"
	[ -d "${ROOT_DIR}" ] || prepare_jail "${name}" "${ip}"
	add_alias "${ip}"
	mount_jail_root

	if jail_exists "${name}"; then
		echo "Jail ${name} already running"
		return
	fi

	jailctl create -n "${name}" -i "${ip}" "${ROOT_DIR}"
	require_supervise_cmd
	# shellcheck disable=SC2086
	set -- ${JAIL_SUPERVISE_CMD}
	jailctl supervise "${name}" "$@"
	echo "Started jail ${name} at ${ip}"
}

stop_jail() {
	need_root
	require_tools
	name=$1

	if jail_exists "${name}"; then
		jid=$(jailctl list | awk -v n="${name}" '$3==n{print $1}')
		stop_jail_processes "${name}" "${jid}"
		jailctl destroy "${jid}"
		echo "Destroyed jail ${name} (jid ${jid})"
	fi

	jail_paths "${name}"
	if [ -d "${ROOT_DIR}" ]; then
		umount_jail_root || true
	fi
}

start_all() {
	host_net_up
	for_each_jail_conf start_jail
	npf_sync
}

stop_all() {
	for_each_jail_conf stop_jail
}

status() {
	jailctl list || true
	echo
	echo "# aliases on ${JAIL_HOST_IF}"
	ifconfig "${JAIL_HOST_IF}" | awk '/inet / {print}' || true
	echo
	mount | awk -v p="${JAIL_DATA_DIR}/" 'index($0,p){print}'
}

gen_rc() {
	out=${1:-/etc/rc.d/jailmgr}
	cat > "${out}" <<'RC'
#!/bin/sh
#
# PROVIDE: jailmgr
# REQUIRE: NETWORKING npf
# KEYWORD: shutdown
#

. /etc/rc.subr

name="jailmgr"
rcvar=jailmgr
command="/usr/local/sbin/jailmgr"
start_cmd="${name}_start"
stop_cmd="${name}_stop"
status_cmd="${name}_status"

: ${jailmgr:=NO}
: ${jailmgr_conf:=/etc/jailmgr.conf}

jailmgr_start()
{
	JAILMGR_CONF="${jailmgr_conf}" ${command} start --all
}

jailmgr_stop()
{
	JAILMGR_CONF="${jailmgr_conf}" ${command} stop --all
}

jailmgr_status()
{
	JAILMGR_CONF="${jailmgr_conf}" ${command} status
}

load_rc_config $name
run_rc_command "$1"
RC
	chmod +x "${out}"
	echo "Wrote ${out}"
}

cmd=${1:-}
case "${cmd}" in
	bootstrap)
		fetch_sets
		build_base
		;;
	prepare)
		[ $# -eq 3 ] || { usage; exit 1; }
		prepare_jail "$2" "$3"
		;;
	host-net-up)
		host_net_up
		;;
	host-net-down)
		host_net_down
		;;
	start)
		if [ $# -eq 2 ] && [ "$2" = "--all" ]; then
			start_all
		elif [ $# -eq 2 ]; then
			start_jail "$2"
		elif [ $# -eq 3 ]; then
			start_jail "$2" "$3"
		else
			usage
			exit 1
		fi
		;;
	stop)
		if [ $# -eq 2 ] && [ "$2" = "--all" ]; then
			stop_all
		elif [ $# -eq 2 ]; then
			stop_jail "$2"
		else
			usage
			exit 1
		fi
		;;
	npf-sync)
		npf_sync
		;;
	status)
		status
		;;
	gen-rc)
		gen_rc "${2:-/etc/rc.d/jailmgr}"
		;;
	*)
		usage
		exit 1
		;;
esac
