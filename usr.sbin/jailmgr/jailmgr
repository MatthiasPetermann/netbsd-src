#
# secmodel_jail, jailctl, and jailmgr designed and implemented by
# Matthias Petermann, inspired by FreeBSD jails.
#
# Build and manage jailctl jails with a shared read-only base layer.
#
# Layout:
#   /var/jailmgr/releases/<release>/<arch>/{base,etc}.tar.xz
#   /var/jailmgr/base/<release>-<arch>/
#   /var/jailmgr/jails/<name>/{root,etc,var,tmp,home,pkg}
#
# Config:
#   /etc/jailmgr.conf
#
# Requires root, jailctl, tar, and mount_null.

set -eu

PATH=/sbin:/bin:/usr/sbin:/usr/bin

CONF_FILE=${JAILMGR_CONF:-/etc/jailmgr.conf}

RELEASE=10.0
MACHINE_ARCH=$(uname -m)
NETBSD_MIRROR=
JAIL_BASE_DIR=/var/jailmgr/base
JAIL_DATA_DIR=/var/jailmgr/jails
JAIL_RELEASE_DIR=/var/jailmgr/releases
JAIL_DEFAULT_USER=user
# Required command (with args) to supervise inside each jail, e.g. "/bin/sh /etc/rc"
JAIL_SUPERVISE_CMD=

# Per-jail local /dev setup.
JAIL_LOCAL_DEV=YES
JAIL_DEV_SIZE=8m
JAIL_DEVICES="std ptm"
JAIL_PTYFS=YES

if [ -r "${CONF_FILE}" ]; then
	# shellcheck disable=SC1090
	. "${CONF_FILE}"
fi

if [ -z "${NETBSD_MIRROR}" ]; then
	NETBSD_MIRROR="https://cdn.netbsd.org/pub/NetBSD/NetBSD-${RELEASE}/${MACHINE_ARCH}/binary/sets"
fi

BASE_LAYER="${JAIL_BASE_DIR}/${RELEASE}-${MACHINE_ARCH}"
SET_DIR="${JAIL_RELEASE_DIR}/${RELEASE}/${MACHINE_ARCH}"
BASE_SET="${SET_DIR}/base.tar.xz"
ETC_SET="${SET_DIR}/etc.tar.xz"

usage() {
	cat <<USAGE
Usage: $0 <command> [args]

Commands:
  bootstrap                   Download sets and build shared base layer
  prepare <name>              Create jail instance directories and persist jail.conf
  start <name>                Mount jail root and supervise jail via jailctl
  start --all                 Start all configured jails
  stop <name>                 Stop one jail by terminating its jailctl supervisor
  stop --all                  Stop all configured jails
  restart <name>              Stop and start one jail
  restart --all               Stop and start all configured jails
  status                      Show jailctl list and mount status
  gen-rc [/etc/rc.d/jailmgr]  Emit rc.d wrapper script

Each jail stores its own config at: ${JAIL_DATA_DIR}/<name>/jail.conf
Per-jail jail.conf can set: JAIL_PORTS="22,80,443"
JAIL_SUPERVISE_CMD format: "/path/to/cmd arg1 arg2" (required)
USAGE
}

need_root() {
	if [ "$(id -u)" -ne 0 ]; then
		echo "must be root" >&2
		exit 1
	fi
}

require_tools() {
	for t in jailctl tar mount mount_tmpfs umount ps; do
		command -v "${t}" >/dev/null 2>&1 || {
			echo "missing required tool: ${t}" >&2
			exit 1
		}
	done
}

ensure_default_conf() {
	if [ -e "${CONF_FILE}" ]; then
		return
	fi

	mkdir -p "$(dirname "${CONF_FILE}")"
	cat > "${CONF_FILE}" <<CONF
# autogenerated by jailmgr bootstrap
# Required command (with optional args) to supervise in each jail.
# Example starts the normal NetBSD in-jail boot sequence:
JAIL_SUPERVISE_CMD="/bin/sh /etc/rc"
CONF
	echo "Created default ${CONF_FILE}"
}

jail_monitor_pid() {
	name=$1
	jid=$2
	ps -axo pid,command | awk -v n="${name}" -v j="${jid}" '
		$0 ~ "jailctl supervise jail=" n " jid=" j { print $1; exit }
	'
}

stop_jail_processes() {
	name=$1
	jid=$2
	monitor_pid=$(jail_monitor_pid "${name}" "${jid}" || true)

	# A jail can be alive without an active supervise process (e.g. it already
	# exited). In that case we still want stop_jail() to continue with destroy.
	[ -n "${monitor_pid}" ] || return 0

	kill -TERM "${monitor_pid}" >/dev/null 2>&1 || true
	sleep 1
	kill -KILL "${monitor_pid}" >/dev/null 2>&1 || true
}

fetch_sets() {
	need_root
	require_tools
	mkdir -p "${SET_DIR}"

	fetch_url="${NETBSD_MIRROR%/}"

	if command -v ftp >/dev/null 2>&1; then
		ftp -V -o "${BASE_SET}" "${fetch_url}/base.tar.xz"
		ftp -V -o "${ETC_SET}" "${fetch_url}/etc.tar.xz"
	elif command -v curl >/dev/null 2>&1; then
		curl -fL -o "${BASE_SET}" "${fetch_url}/base.tar.xz"
		curl -fL -o "${ETC_SET}" "${fetch_url}/etc.tar.xz"
	else
		echo "need ftp(1) or curl to fetch sets" >&2
		exit 1
	fi

	echo "Downloaded sets to ${SET_DIR}"
}

ensure_secmodel_jail() {
	need_root

	if ! modstat | awk '
		$0 ~ /(^|[[:space:]])secmodel_jail([[:space:]]|$)/ { found=1 }
		END { exit !found }
	'; then
		modload secmodel_jail
		echo "Loaded secmodel_jail module"
	fi

	if [ ! -f /etc/modules.conf ]; then
		: > /etc/modules.conf
	fi

	if ! grep -Eq '^[[:space:]]*secmodel_jail([[:space:]]|$)' /etc/modules.conf; then
		echo "secmodel_jail" >> /etc/modules.conf
		echo "Added secmodel_jail to /etc/modules.conf"
	fi
}

build_base() {
	need_root
	require_tools
	[ -f "${BASE_SET}" ] || {
		echo "missing ${BASE_SET}; run bootstrap first" >&2
		exit 1
	}

	mkdir -p "${BASE_LAYER}"
	tar -xzp -f "${BASE_SET}" -C "${BASE_LAYER}"
	echo "Prepared base layer at ${BASE_LAYER}"
}

jail_paths() {
	name=$1
	JAIL_DIR="${JAIL_DATA_DIR}/${name}"
	ROOT_DIR="${JAIL_DIR}/root"
	ETC_DIR="${JAIL_DIR}/etc"
	VAR_DIR="${JAIL_DIR}/var"
	TMP_DIR="${JAIL_DIR}/tmp"
	HOME_DIR="${JAIL_DIR}/home"
	PKG_DIR="${JAIL_DIR}/pkg"
	DEV_DIR="${JAIL_DIR}/dev"
	JAIL_CONF="${JAIL_DIR}/jail.conf"
}

load_jail_conf() {
	name=$1
	jail_paths "${name}"
	if [ ! -r "${JAIL_CONF}" ]; then
		echo "missing ${JAIL_CONF}; run prepare ${name} first" >&2
		exit 1
	fi

	JAIL_NAME=
	JAIL_SUPERVISE_CMD_LOCAL=
	JAIL_PORTS=
	# shellcheck disable=SC1090
	. "${JAIL_CONF}"

	if [ -z "${JAIL_NAME:-}" ]; then
		JAIL_NAME=${name}
	fi
	if [ "${JAIL_NAME}" != "${name}" ]; then
		echo "jail.conf mismatch: expected JAIL_NAME=${name}, got ${JAIL_NAME}" >&2
		exit 1
	fi
}

for_each_jail_conf() {
	action=$1
	for jail_conf in "${JAIL_DATA_DIR}"/*/jail.conf; do
		[ -f "${jail_conf}" ] || continue
		name=${jail_conf%/jail.conf}
		name=${name##*/}
		"${action}" "${name}"
	done
}

setup_local_dev() {
	if [ "${JAIL_LOCAL_DEV}" != "YES" ]; then
		return
	fi

	mkdir -p "${ROOT_DIR}/dev"
	if ! mount | awk -v p="on ${ROOT_DIR}/dev " 'index($0,p){found=1} END{exit !found}'; then
		mount_tmpfs -s "${JAIL_DEV_SIZE}" tmpfs "${ROOT_DIR}/dev"
	fi

	if [ -f "${ROOT_DIR}/dev/MAKEDEV" ]; then
		:
	elif [ -f /dev/MAKEDEV ]; then
		cp /dev/MAKEDEV "${ROOT_DIR}/dev/MAKEDEV"
		chmod 555 "${ROOT_DIR}/dev/MAKEDEV"
	else
		echo "warning: MAKEDEV not found; skipping /dev node creation" >&2
		return
	fi

	# shellcheck disable=SC2086
	(cd "${ROOT_DIR}/dev" && sh ./MAKEDEV ${JAIL_DEVICES})

	if [ "${JAIL_PTYFS}" = "YES" ]; then
		mkdir -p "${ROOT_DIR}/dev/pts"
		if ! mount | awk -v p="on ${ROOT_DIR}/dev/pts " 'index($0,p){found=1} END{exit !found}'; then
			mount -t ptyfs ptyfs "${ROOT_DIR}/dev/pts"
		fi
	fi
}

setup_etc() {
	[ -f "${ETC_SET}" ] || {
		echo "missing ${ETC_SET}; run bootstrap first" >&2
		exit 1
	}

	if [ ! -f "${ETC_DIR}/rc.conf" ]; then
		tar -xzp -f "${ETC_SET}" -C "${JAIL_DIR}"
	fi


	mkdir -p "${ETC_DIR}/ssh"

	grep -q '^sshd=YES' "${ETC_DIR}/rc.conf" 2>/dev/null ||
		echo 'sshd=YES' >> "${ETC_DIR}/rc.conf"

	grep -q '^hostname=' "${ETC_DIR}/rc.conf" 2>/dev/null ||
		echo "hostname=${name}" >> "${ETC_DIR}/rc.conf"

	if [ ! -f "${ETC_DIR}/master.passwd" ]; then
		echo "warning: ${ETC_DIR}/master.passwd not found; user provisioning skipped" >&2
		return
	fi

	if [ -z "${JAIL_DEFAULT_USER}" ]; then
		return
	fi

	if ! awk -F: -v u="${JAIL_DEFAULT_USER}" '$1==u{found=1} END{exit !found}' "${ETC_DIR}/master.passwd"; then
		echo "${JAIL_DEFAULT_USER}:*:1000:1000::0:0:Jail User:/home/${JAIL_DEFAULT_USER}:/bin/ksh" >> "${ETC_DIR}/master.passwd"
		pwd_mkdb -d "${JAIL_DIR}" "${ETC_DIR}/master.passwd"
	fi
}

mount_jail_root() {
	# Ensure mount targets exist in the base layer before mounting it read-only.
	mkdir -p "${BASE_LAYER}/home"
	mkdir -p "${BASE_LAYER}/usr/pkg"

	if mount | awk -v p="on ${ROOT_DIR} " 'index($0,p){found=1} END{exit !found}'; then
		return
	fi

	mount -t null -o ro "${BASE_LAYER}" "${ROOT_DIR}"
	mount -t null "${ETC_DIR}" "${ROOT_DIR}/etc"
	mount -t null "${VAR_DIR}" "${ROOT_DIR}/var"
	mount -t null "${TMP_DIR}" "${ROOT_DIR}/tmp"
	mount -t null "${HOME_DIR}" "${ROOT_DIR}/home"
	mount -t null "${PKG_DIR}" "${ROOT_DIR}/usr/pkg"
	setup_local_dev
}

umount_jail_root() {
	for d in dev/pts dev usr/pkg home tmp var etc ""; do
		mp="${ROOT_DIR}${d:+/$d}"
		if mount | awk -v p="on ${mp} " 'index($0,p){found=1} END{exit !found}'; then
			umount "${mp}"
		fi
	done
}

prepare_jail() {
	need_root
	require_tools
	name=$1

	jail_paths "${name}"
	mkdir -p "${ROOT_DIR}" "${ETC_DIR}" "${VAR_DIR}" "${TMP_DIR}" "${HOME_DIR}" "${PKG_DIR}" \
		"${DEV_DIR}" "${VAR_DIR}/run" "${VAR_DIR}/log"
	if [ -n "${JAIL_DEFAULT_USER}" ]; then
		mkdir -p "${HOME_DIR}/${JAIL_DEFAULT_USER}"
	fi
	chmod 1777 "${TMP_DIR}"
	setup_etc

	cat > "${JAIL_CONF}" <<CONF
# autogenerated by jailmgr
JAIL_NAME=${name}
JAIL_PORTS=
JAIL_RELEASE=${RELEASE}
JAIL_ARCH=${MACHINE_ARCH}
CONF

	echo "Prepared jail ${name}"
}

jail_exists() {
	name=$1
	jailctl list | awk -v n="${name}" '$3==n{found=1} END{exit !found}'
}

require_supervise_cmd() {
	if [ -z "${JAIL_SUPERVISE_CMD}" ]; then
		echo "JAIL_SUPERVISE_CMD must be set in ${CONF_FILE} (example: /bin/sh /etc/rc)" >&2
		exit 1
	fi
}

validate_jail_ports() {
	ports=$1
	[ -n "${ports}" ] || return 0
	old_ifs=${IFS}
	IFS=,
	set -- ${ports}
	IFS=${old_ifs}
	for p in "$@"; do
		case "${p}" in
			''|*[!0-9]*)
				echo "invalid JAIL_PORTS entry: ${p}" >&2
				exit 1
				;;
		esac
		if [ "${p}" -lt 1 ] || [ "${p}" -gt 65535 ]; then
			echo "invalid JAIL_PORTS entry: ${p}" >&2
			exit 1
		fi
	done
}

start_jail() {
	need_root
	require_tools
	name=$1

	load_jail_conf "${name}"
	effective_supervise_cmd=${JAIL_SUPERVISE_CMD}
	if [ -n "${JAIL_SUPERVISE_CMD_LOCAL:-}" ]; then
		effective_supervise_cmd=${JAIL_SUPERVISE_CMD_LOCAL}
	fi
	ports=${JAIL_PORTS:-}
	validate_jail_ports "${ports}"
	if [ -z "${effective_supervise_cmd}" ]; then
		echo "JAIL_SUPERVISE_CMD must be set in ${CONF_FILE} (example: /bin/sh /etc/rc)" >&2
		exit 1
	fi

	jail_paths "${name}"
	[ -d "${ROOT_DIR}" ] || prepare_jail "${name}"
	mount_jail_root

	if jail_exists "${name}"; then
		echo "Jail ${name} already running"
		return
	fi

	if [ -n "${ports}" ]; then
		jailctl create -n "${name}" -p "${ports}" "${ROOT_DIR}"
	else
		jailctl create -n "${name}" "${ROOT_DIR}"
	fi
	# shellcheck disable=SC2086
	set -- ${effective_supervise_cmd}
	# Start under nohup *and* in the background so rc(8)/run_rc_command does
	# not keep it as the rc script foreground process.  Otherwise the
	# supervisor can be tied to rc script lifetime and disappear once startup
	# handling completes.
	nohup jailctl supervise "${name}" "$@" >/dev/null 2>&1 &
	echo "Started jail ${name}"
}

stop_jail() {
	need_root
	require_tools
	name=$1

	if jail_exists "${name}"; then
		jid=$(jailctl list | awk -v n="${name}" '$3==n{print $1}')
		stop_jail_processes "${name}" "${jid}"
		jailctl destroy "${jid}"
		echo "Destroyed jail ${name} (jid ${jid})"
	fi

	jail_paths "${name}"
	if [ -d "${ROOT_DIR}" ]; then
		umount_jail_root || true
	fi
}

start_all() {
	failed=0
	for jail_conf in "${JAIL_DATA_DIR}"/*/jail.conf; do
		[ -f "${jail_conf}" ] || continue
		name=${jail_conf%/jail.conf}
		name=${name##*/}
		if ! start_jail "${name}"; then
			failed=1
			echo "Failed to start jail ${name}; continuing" >&2
		fi
	done
	if [ "${failed}" -ne 0 ]; then
		exit 1
	fi
}

stop_all() {
	for_each_jail_conf stop_jail
}

restart_jail() {
	name=$1

	stop_jail "${name}"
	start_jail "${name}"
}

restart_all() {
	stop_all
	start_all
}

status() {
	jailctl list || true
	echo
	mount | awk -v p="${JAIL_DATA_DIR}/" 'index($0,p){print}'
}

gen_rc() {
	out=${1:-/etc/rc.d/jailmgr}
	cat > "${out}" <<'RC'
#!/bin/sh
#
# PROVIDE: jailmgr
# REQUIRE: NETWORKING
# KEYWORD: shutdown
#

. /etc/rc.subr

name="jailmgr"
rcvar=jailmgr
command="/usr/sbin/jailmgr"
start_cmd="${name}_start"
stop_cmd="${name}_stop"
status_cmd="${name}_status"

: ${jailmgr:=NO}
: ${jailmgr_conf:=/etc/jailmgr.conf}

jailmgr_start()
{
	JAILMGR_CONF="${jailmgr_conf}" ${command} start --all
}

jailmgr_stop()
{
	JAILMGR_CONF="${jailmgr_conf}" ${command} stop --all
}

jailmgr_status()
{
	JAILMGR_CONF="${jailmgr_conf}" ${command} status
}

load_rc_config $name
run_rc_command "$1"
RC
	chmod +x "${out}"
	echo "Wrote ${out}"
}

cmd=${1:-}
case "${cmd}" in
	bootstrap)
		ensure_default_conf
		ensure_secmodel_jail
		fetch_sets
		build_base
		;;
	prepare)
		if [ $# -eq 2 ]; then
			prepare_jail "$2"
		else
			usage
			exit 1
		fi
		;;
	start)
		if [ $# -eq 2 ] && [ "$2" = "--all" ]; then
			start_all
		elif [ $# -eq 2 ]; then
			start_jail "$2"
		else
			usage
			exit 1
		fi
		;;
	stop)
		if [ $# -eq 2 ] && [ "$2" = "--all" ]; then
			stop_all
		elif [ $# -eq 2 ]; then
			stop_jail "$2"
		else
			usage
			exit 1
		fi
		;;
	restart)
		if [ $# -eq 2 ] && [ "$2" = "--all" ]; then
			restart_all
		elif [ $# -eq 2 ]; then
			restart_jail "$2"
		else
			usage
			exit 1
		fi
		;;
	status)
		status
		;;
	gen-rc)
		gen_rc "${2:-/etc/rc.d/jailmgr}"
		;;
	*)
		usage
		exit 1
		;;
esac
