#
# Build and manage cellctl cells with a shared read-only base layer.
#
# Layout:
#   /var/cellmgr/releases/<release>/<arch>/{base,etc}.tar.xz
#   /var/cellmgr/base/<release>-<arch>/
#   /var/cellmgr/cells/<name>/{root,data}
#
# Config:
#   /etc/cellmgr.conf
#
# Requires root, cellctl, tar, and mount_null.

set -eu

PATH=/sbin:/bin:/usr/sbin:/usr/bin

CONF_FILE=${CELLMGR_CONF:-/etc/cellmgr.conf}

detect_release() {
	# Derive a release token from uname -r suitable for set URLs.
	# Keep official release tags like _RC* / _BETA*, but drop build/source
	# branch suffixes like _STABLE.
	rel=$(uname -r)
	rel=$(printf '%s' "${rel}" | sed -e 's/[^A-Za-z0-9._-].*$//')

	case "${rel}" in
	*_[Rr][Cc]*|*_[Bb][Ee][Tt][Aa]*)
		# Keep prerelease tag (e.g. 11.0_RC1).
		:
		;;
	*_* )
		# Drop non-release suffixes (e.g. _STABLE, _current snapshot tags).
		rel=${rel%%_*}
		:
		;;
	esac

	major=${rel%%.*}
	if [ -z "${major}" ] || [ "${major}" = "${rel}" ]; then
		echo "failed to detect running NetBSD release from uname -r (${rel})" >&2
		exit 1
	fi

	rest=${rel#*.}
	minor=${rest%%.*}
	if [ -z "${minor}" ]; then
		echo "failed to detect NetBSD release minor from uname -r (${rel})" >&2
		exit 1
	fi

	printf '%s.%s\n' "${major}" "${minor}"
}

DETECTED_RELEASE=$(detect_release)
DETECTED_MACHINE_ARCH=$(uname -m)

RELEASE=${DETECTED_RELEASE}
MACHINE_ARCH=${DETECTED_MACHINE_ARCH}
NETBSD_MIRROR=
CELL_BASE_DIR=/var/cellmgr/base
CELL_DATA_DIR=/var/cellmgr/cells
CELL_RELEASE_DIR=/var/cellmgr/releases

# Per-cell local /dev setup.
CELL_LOCAL_DEV=YES
CELL_DEV_SIZE=8m
CELL_DEVICES="std ptm"
CELL_PTYFS=YES

if [ -r "${CONF_FILE}" ]; then
	# shellcheck disable=SC1090
	. "${CONF_FILE}"
fi

if [ -z "${RELEASE:-}" ]; then
	RELEASE=${DETECTED_RELEASE}
fi

if [ -z "${MACHINE_ARCH:-}" ]; then
	MACHINE_ARCH=${DETECTED_MACHINE_ARCH}
fi

write_default_conf() {
	if [ -r "${CONF_FILE}" ]; then
		return
	fi

	cat > "${CONF_FILE}" <<CONF
# autogenerated by cellmgr bootstrap

RELEASE=${RELEASE}
MACHINE_ARCH=${MACHINE_ARCH}

# Optional override. If unset/empty, cellmgr derives:
# https://cdn.netbsd.org/pub/NetBSD/NetBSD-\${RELEASE}/
# \${MACHINE_ARCH}/binary/sets
NETBSD_MIRROR=""

CELL_BASE_DIR=${CELL_BASE_DIR}
CELL_DATA_DIR=${CELL_DATA_DIR}
CELL_RELEASE_DIR=${CELL_RELEASE_DIR}

# Per-cell local /dev setup (tmpfs + MAKEDEV)
CELL_LOCAL_DEV=${CELL_LOCAL_DEV}
CELL_DEV_SIZE=${CELL_DEV_SIZE}
CELL_DEVICES="${CELL_DEVICES}"
CELL_PTYFS=${CELL_PTYFS}
CONF

	echo "Generated ${CONF_FILE} (RELEASE=${RELEASE})"
}

if [ -z "${NETBSD_MIRROR}" ]; then
	NETBSD_MIRROR="https://cdn.netbsd.org/pub/NetBSD/NetBSD-${RELEASE}/\
${MACHINE_ARCH}/binary/sets"
fi

BASE_LAYER="${CELL_BASE_DIR}/${RELEASE}-${MACHINE_ARCH}"
SET_DIR="${CELL_RELEASE_DIR}/${RELEASE}/${MACHINE_ARCH}"
BASE_SET="${SET_DIR}/base.tar.xz"
ETC_SET="${SET_DIR}/etc.tar.xz"

usage() {
	cat <<USAGE
Usage: $0 <command> [args]

Commands:
  bootstrap                   Download sets and build shared base layer
  create [-a] [-x cmd] [-l profile] [-r port[,port...]]
         [-f facility] [-o stdout-level] [-e stderr-level] [-t tag]
         <name>
                               Create cell instance directories and
                               persist cell.conf
  start <name>                Mount cell root and supervise cell via cellctl
  start --all                 Start all configured cells
  stop <name>                 Stop one cell by terminating its
                               cellctl supervisor
  stop --all                  Stop all configured cells
  restart <name>              Stop and start one cell
  restart --all               Stop and start all configured cells
  apply [--ephemeral] <name> [script|-] [-- arg ...]
                              Execute shell script inside cell (path or stdin)
  config <name>               Open cell.conf for cell in standard editor
  status                      Show cellctl list and mount status
  list                        List configured cells as table

Each cell stores its own config at: ${CELL_DATA_DIR}/<name>/cell.conf
USAGE
}

# Guard helper used by all mutating operations; cell lifecycle changes are
# intentionally root-only because they manipulate mounts, module state and
# kernel cell controls.
need_root() {
	if [ "$(id -u)" -ne 0 ]; then
		echo "must be root" >&2
		exit 1
	fi
}

# Validate external toolchain early so command failures happen before partial
# state changes (mounts, cell creation, config writes).
require_tools() {
	for t in cellctl tar mount mount_tmpfs umount ps; do
		command -v "${t}" >/dev/null 2>&1 || {
			echo "missing required tool: ${t}" >&2
			exit 1
		}
	done
}

ensure_rc_conf_entry() {
	if [ ! -f /etc/rc.conf ]; then
		: > /etc/rc.conf
	fi

	if grep -Eq '^[[:space:]]*cellmgr=' /etc/rc.conf; then
		return
	fi

	echo 'cellmgr=NO' >> /etc/rc.conf
	echo 'Initialized cellmgr=NO in /etc/rc.conf'
}

escape_dq() {
	printf '%s' "$1" | sed -e 's/[\\$"`]/\\&/g'
}

cell_monitor_pid() {
	name=$1
	jid=$2
	ps -axo pid,command | awk -v n="${name}" -v j="${jid}" '
		$0 ~ "cellctl supervise cell=" n " jid=" j { print $1; exit }
	'
}

stop_cell_processes() {
	name=$1
	jid=$2
	monitor_pid=$(cell_monitor_pid "${name}" "${jid}" || true)

	# A cell can be alive without an active supervise process (e.g. it already
	# exited). In that case we still want stop_cell() to continue with destroy.
	[ -n "${monitor_pid}" ] || return 0

	kill -TERM "${monitor_pid}" >/dev/null 2>&1 || true
	sleep 1
	kill -KILL "${monitor_pid}" >/dev/null 2>&1 || true
}

fetch_sets() {
	need_root
	require_tools
	mkdir -p "${SET_DIR}"

	fetch_url="${NETBSD_MIRROR%/}"

	if command -v ftp >/dev/null 2>&1; then
		ftp -V -o "${BASE_SET}" "${fetch_url}/base.tar.xz"
		ftp -V -o "${ETC_SET}" "${fetch_url}/etc.tar.xz"
	elif command -v curl >/dev/null 2>&1; then
		curl -fL -o "${BASE_SET}" "${fetch_url}/base.tar.xz"
		curl -fL -o "${ETC_SET}" "${fetch_url}/etc.tar.xz"
	else
		echo "need ftp(1) or curl to fetch sets" >&2
		exit 1
	fi

	echo "Downloaded sets to ${SET_DIR}"
}

# Ensure the kernel cell security model is available now and across reboot.
# This is the integration point between cellmgr automation and secmodel_cell.
ensure_secmodel_cell() {
	need_root

	if ! modstat | awk '
		$0 ~ /(^|[[:space:]])secmodel_cell([[:space:]]|$)/ { found=1 }
		END { exit !found }
	'; then
		modload secmodel_cell
		echo "Loaded secmodel_cell module"
	fi

	if [ ! -f /etc/modules.conf ]; then
		: > /etc/modules.conf
	fi

	if ! grep -Eq '^[[:space:]]*secmodel_cell([[:space:]]|$)' \
	    /etc/modules.conf; then
		echo "secmodel_cell" >> /etc/modules.conf
		echo "Added secmodel_cell to /etc/modules.conf"
	fi
}

ensure_base_writable_links() {
	# Writable cell paths live below /.data (mounted per-cell).  Keep these
	# links in the shared read-only base so every cell sees the same layout.
	if [ ! -d "${BASE_LAYER}" ]; then
		echo "missing ${BASE_LAYER}; run bootstrap first" >&2
		exit 1
	fi

	mkdir -p "${BASE_LAYER}/.data" "${BASE_LAYER}/usr"
	rm -rf "${BASE_LAYER}/etc" "${BASE_LAYER}/var" "${BASE_LAYER}/tmp" \
		"${BASE_LAYER}/home" "${BASE_LAYER}/root" "${BASE_LAYER}/usr/pkg" \
		"${BASE_LAYER}/.cshrc" "${BASE_LAYER}/.profile"
	ln -s ".data/etc" "${BASE_LAYER}/etc"
	ln -s ".data/var" "${BASE_LAYER}/var"
	ln -s ".data/tmp" "${BASE_LAYER}/tmp"
	ln -s ".data/home" "${BASE_LAYER}/home"
	ln -s ".data/root" "${BASE_LAYER}/root"
	ln -s ".data/.cshrc" "${BASE_LAYER}/.cshrc"
	ln -s ".data/.profile" "${BASE_LAYER}/.profile"
	ln -s "../.data/usr/pkg" "${BASE_LAYER}/usr/pkg"
}


build_base() {
	need_root
	require_tools
	[ -f "${BASE_SET}" ] || {
		echo "missing ${BASE_SET}; run bootstrap first" >&2
		exit 1
	}

	mkdir -p "${BASE_LAYER}"
	tar -xzp -f "${BASE_SET}" -C "${BASE_LAYER}"
	ensure_base_writable_links
	echo "Prepared base layer at ${BASE_LAYER}"
}


cell_paths() {
	name=$1
	CELL_DIR="${CELL_DATA_DIR}/${name}"
	ROOT_DIR="${CELL_DIR}/root"
	DATA_DIR="${CELL_DIR}/data"
	DATA_ETC_DIR="${DATA_DIR}/etc"
	DATA_VAR_DIR="${DATA_DIR}/var"
	DATA_TMP_DIR="${DATA_DIR}/tmp"
	DATA_HOME_DIR="${DATA_DIR}/home"
	DATA_ROOT_DIR="${DATA_DIR}/root"
	DATA_PKG_DIR="${DATA_DIR}/usr/pkg"
	CELL_CONF="${CELL_DIR}/cell.conf"
}

load_cell_conf() {
	name=$1
	cell_paths "${name}"
	if [ ! -r "${CELL_CONF}" ]; then
		echo "missing ${CELL_CONF}; run create ${name} first" >&2
		exit 1
	fi

	CELL_NAME=
	CELL_SUPERVISE_CMD=
	CELL_CREATE_PROFILE=
	CELL_CREATE_RESERVED_PORTS=
	CELL_SUPERVISE_FACILITY=
	CELL_SUPERVISE_STDOUT_LEVEL=
	CELL_SUPERVISE_STDERR_LEVEL=
	CELL_SUPERVISE_TAG=
	CELL_AUTOSTART=NO
	# shellcheck disable=SC1090
	. "${CELL_CONF}"

	if [ -z "${CELL_NAME:-}" ]; then
		CELL_NAME=${name}
	fi
	if [ "${CELL_NAME}" != "${name}" ]; then
		echo "cell.conf mismatch: expected CELL_NAME=${name}, got ${CELL_NAME}" >&2
		exit 1
	fi
}

cell_autostart_enabled() {
	name=$1
	load_cell_conf "${name}"
	[ "${CELL_AUTOSTART:-NO}" = "YES" ]
}

# Build per-cell /dev view backed by tmpfs (+ optional ptyfs).  This keeps
# device nodes scoped to the cell filesystem instead of bind-sharing host /dev.
setup_local_dev() {
	if [ "${CELL_LOCAL_DEV}" != "YES" ]; then
		return
	fi

	mkdir -p "${ROOT_DIR}/dev"
	if ! mount | awk -v p="on ${ROOT_DIR}/dev " \
	    'index($0,p){found=1} END{exit !found}'; then
		mount_tmpfs -s "${CELL_DEV_SIZE}" tmpfs "${ROOT_DIR}/dev"
	fi

	if [ ! -f "${ROOT_DIR}/dev/MAKEDEV" ]; then
		[ -f "${ETC_SET}" ] || {
			echo "warning: ${ETC_SET} not found; skipping /dev node creation" >&2
			return
		}

		tar -xzp -f "${ETC_SET}" -C "${ROOT_DIR}" ./dev/MAKEDEV
		chmod 555 "${ROOT_DIR}/dev/MAKEDEV"
		if tar -tzp -f "${ETC_SET}" ./dev/MAKEDEV.local >/dev/null 2>&1; then
			tar -xzp -f "${ETC_SET}" -C "${ROOT_DIR}" ./dev/MAKEDEV.local
			chmod 444 "${ROOT_DIR}/dev/MAKEDEV.local"
		fi
	fi

	# shellcheck disable=SC2086
	(cd "${ROOT_DIR}/dev" && sh ./MAKEDEV ${CELL_DEVICES})

	if [ "${CELL_PTYFS}" = "YES" ]; then
		mkdir -p "${ROOT_DIR}/dev/pts"
		if ! mount | awk -v p="on ${ROOT_DIR}/dev/pts " \
		    'index($0,p){found=1} END{exit !found}'; then
			mount -t ptyfs ptyfs "${ROOT_DIR}/dev/pts"
		fi
	fi
}

setup_etc() {
	[ -f "${ETC_SET}" ] || {
		echo "missing ${ETC_SET}; run bootstrap first" >&2
		exit 1
	}

	if [ ! -f "${DATA_ETC_DIR}/rc.conf" ]; then
		# etc.tar.xz stores root dotfiles as hardlinks to ./.cshrc/.profile.
		# Extract those link targets too so tar does not abort with missing
		# hard-link target errors while unpacking ./root.
		tar -xzp -f "${ETC_SET}" -C "${DATA_DIR}" \
			./.cshrc ./.profile ./etc ./root ./var
	fi


	# Keep cell DNS resolver config aligned with the host at create time.
	# This provides working name resolution out-of-the-box for typical setups.
	if [ -f /etc/resolv.conf ]; then
		cp /etc/resolv.conf "${DATA_ETC_DIR}/resolv.conf"
	fi

	grep -q '^hostname=' "${DATA_ETC_DIR}/rc.conf" 2>/dev/null ||
		echo "hostname=${name}" >> "${DATA_ETC_DIR}/rc.conf"
}

# Compose the final cell root by overlaying writable per-cell directories on
# top of the shared read-only base layer.
mount_cell_root() {
	ensure_base_writable_links

	if mount | awk -v p="on ${ROOT_DIR} " \
	    'index($0,p){found=1} END{exit !found}'; then
		return
	fi

	mount -t null -o ro "${BASE_LAYER}" "${ROOT_DIR}"
	mount -t null "${DATA_DIR}" "${ROOT_DIR}/.data"
	setup_local_dev
}

umount_cell_root() {
	for d in dev/pts dev .data ""; do
		mp="${ROOT_DIR}${d:+/$d}"
		if mount | awk -v p="on ${mp} " 'index($0,p){found=1} END{exit !found}'; then
			umount "${mp}"
		fi
	done
}

# Create persistent on-disk cell structure and write cell.conf consumed by
# start/stop operations.
create_cell() {
	need_root
	require_tools
	name=$1
	autostart=${2:-NO}
	supervise_cmd=${3:-/bin/sleep 60}
	create_profile=${4:-}
	create_reserved_ports=${5:-}
	supervise_facility=${6:-}
	supervise_stdout_level=${7:-}
	supervise_stderr_level=${8:-}
	supervise_tag=${9:-}
	escaped_create_profile=$(escape_dq "${create_profile}")
	escaped_create_reserved_ports=$(escape_dq "${create_reserved_ports}")
	escaped_supervise_cmd=$(escape_dq "${supervise_cmd}")
	escaped_supervise_facility=$(escape_dq "${supervise_facility}")
	escaped_supervise_stdout_level=$(escape_dq "${supervise_stdout_level}")
	escaped_supervise_stderr_level=$(escape_dq "${supervise_stderr_level}")
	escaped_supervise_tag=$(escape_dq "${supervise_tag}")

	cell_paths "${name}"
	mkdir -p "${ROOT_DIR}" "${DATA_VAR_DIR}" "${DATA_TMP_DIR}" \
		"${DATA_HOME_DIR}" "${DATA_ROOT_DIR}" "${DATA_PKG_DIR}" \
		"${DATA_VAR_DIR}/run" "${DATA_VAR_DIR}/log"
	chmod 1777 "${DATA_TMP_DIR}"
	setup_etc

	cat > "${CELL_CONF}" <<CONF
# autogenerated by cellmgr
CELL_NAME=${name}
CELL_RELEASE=${RELEASE}
CELL_ARCH=${MACHINE_ARCH}
CELL_AUTOSTART=${autostart}
# Optional cellctl create(8) policy controls:
CELL_CREATE_PROFILE="${escaped_create_profile}"
CELL_CREATE_RESERVED_PORTS="${escaped_create_reserved_ports}"
# Optional cellctl supervise(8) logging controls:
CELL_SUPERVISE_FACILITY="${escaped_supervise_facility}"
CELL_SUPERVISE_STDOUT_LEVEL="${escaped_supervise_stdout_level}"
CELL_SUPERVISE_STDERR_LEVEL="${escaped_supervise_stderr_level}"
CELL_SUPERVISE_TAG="${escaped_supervise_tag}"
# Required command (with optional args) to supervise in this cell:
CELL_SUPERVISE_CMD="${escaped_supervise_cmd}"
CONF

	echo "Created cell ${name}"
}

cell_exists() {
	name=$1
	cellctl list | awk -v n="${name}" '$4==n{found=1} END{exit !found}'
}

# Start sequence: load config, mount root overlays, allocate kernel cell ID
# through cellctl create, then optionally launch supervised workload with
# cellctl supervise.
start_cell_internal() {
	need_root
	require_tools
	name=$1
	supervise=${2:-YES}

	load_cell_conf "${name}"
	effective_supervise_cmd=${CELL_SUPERVISE_CMD:-}
	if [ "${supervise}" = "YES" ] && [ -z "${effective_supervise_cmd}" ]; then
		echo "CELL_SUPERVISE_CMD must be set in ${CELL_CONF}" \
		    "(example: /bin/sleep 60)" >&2
		exit 1
	fi

	cell_paths "${name}"
	[ -d "${ROOT_DIR}" ] || create_cell "${name}"
	mount_cell_root

	if cell_exists "${name}"; then
		jid=$(cellctl list | awk -v n="${name}" '$4==n{print $1; exit}')
		if [ "${supervise}" != "YES" ]; then
			echo "Cell ${name} already running"
			return
		fi

		monitor_pid=$(cell_monitor_pid "${name}" "${jid}" || true)
		if [ -n "${monitor_pid}" ]; then
			echo "Cell ${name} already running"
			return
		fi
	else
		set -- cellctl create -n "${name}"
		# Persisted cellmgr values map 1:1 to cellctl create options.
		if [ -n "${CELL_CREATE_PROFILE:-}" ]; then
			set -- "$@" -l "${CELL_CREATE_PROFILE}"
		fi
		if [ -n "${CELL_CREATE_RESERVED_PORTS:-}" ]; then
			set -- "$@" -r "${CELL_CREATE_RESERVED_PORTS}"
		fi
		set -- "$@" "${ROOT_DIR}"
		# cellctl create/supervise print "cell <jid>" on stdout; keep cellmgr
		# output concise and only show the high-level status line below.
		"$@" >/dev/null
	fi

	if [ "${supervise}" = "YES" ]; then
		set -- cellctl supervise
		if [ -n "${CELL_SUPERVISE_FACILITY:-}" ]; then
			set -- "$@" -f "${CELL_SUPERVISE_FACILITY}"
		fi
		if [ -n "${CELL_SUPERVISE_STDOUT_LEVEL:-}" ]; then
			set -- "$@" -o "${CELL_SUPERVISE_STDOUT_LEVEL}"
		fi
		if [ -n "${CELL_SUPERVISE_STDERR_LEVEL:-}" ]; then
			set -- "$@" -e "${CELL_SUPERVISE_STDERR_LEVEL}"
		fi
		if [ -n "${CELL_SUPERVISE_TAG:-}" ]; then
			set -- "$@" -t "${CELL_SUPERVISE_TAG}"
		fi
		set -- "$@" "${name}"
		# shellcheck disable=SC2086
		set -f
		set -- "$@" ${effective_supervise_cmd}
		set +f
		"$@" >/dev/null
	fi
	echo "Started cell ${name}"
}

start_cell() {
	start_cell_internal "$1" "YES"
}

# Stop sequence mirrors startup in reverse: stop supervisor, destroy kernel
# cell object, then unmount filesystem overlays.
stop_cell() {
	need_root
	require_tools
	name=$1

	if cell_exists "${name}"; then
		jid=$(cellctl list | awk -v n="${name}" '$4==n{print $1}')
		stop_cell_processes "${name}" "${jid}"
		cellctl destroy "${jid}"
		echo "Destroyed cell ${name} (jid ${jid})"
	fi

	cell_paths "${name}"
	if [ -d "${ROOT_DIR}" ]; then
		umount_cell_root || true
	fi
}

start_all() {
	failed=0
	for cell_conf in "${CELL_DATA_DIR}"/*/cell.conf; do
		[ -f "${cell_conf}" ] || continue
		name=${cell_conf%/cell.conf}
		name=${name##*/}
		if ! cell_autostart_enabled "${name}"; then
			continue
		fi
		if ! start_cell "${name}"; then
			failed=1
			echo "Failed to start cell ${name}; continuing" >&2
		fi
	done
	if [ "${failed}" -ne 0 ]; then
		exit 1
	fi
}

stop_all() {
	for cell_conf in "${CELL_DATA_DIR}"/*/cell.conf; do
		[ -f "${cell_conf}" ] || continue
		name=${cell_conf%/cell.conf}
		name=${name##*/}
		if cell_autostart_enabled "${name}"; then
			stop_cell "${name}"
		fi
	done
}

cell_jid_by_name() {
	name=$1
	cellctl list | awk -v n="${name}" '$4==n{print $1; exit}'
}

require_apply_tools() {
	for t in cellctl mktemp cp; do
		command -v "${t}" >/dev/null 2>&1 || {
			echo "missing required tool: ${t}" >&2
			exit 1
		}
	done
}

apply_cell_script() {
	need_root
	require_tools
	require_apply_tools

	ephemeral=NO
	while [ $# -gt 0 ]; do
		case "$1" in
		--ephemeral)
			ephemeral=YES
			shift
			;;
		--)
			shift
			break
			;;
		-*)
			usage
			exit 1
			;;
		*)
			break
			;;
		esac
	done

	if [ $# -lt 1 ]; then
		usage
		exit 1
	fi

	name=$1
	shift

	script_source=
	if [ $# -gt 0 ] && [ "$1" != "--" ]; then
		script_source=$1
		shift
	fi
	if [ $# -gt 0 ] && [ "$1" = "--" ]; then
		shift
	fi

	if [ -z "${script_source}" ]; then
		if [ -t 0 ]; then
			echo "apply: missing script path (or use stdin with '-')" >&2
			exit 1
		fi
		script_source=-
	fi

	if [ "${script_source}" != "-" ] && [ ! -r "${script_source}" ]; then
		echo "apply: cannot read script: ${script_source}" >&2
		exit 1
	fi

	load_cell_conf "${name}"
	cell_paths "${name}"

	started_by_apply=NO
	if ! cell_exists "${name}"; then
		start_cell_internal "${name}" "NO"
		started_by_apply=YES
	fi

	cell_paths "${name}"
	cell_jid=$(cell_jid_by_name "${name}" || true)
	if [ -z "${cell_jid}" ]; then
		echo "apply: failed to resolve JID for cell ${name}" >&2
		exit 1
	fi

	if command -v uuidgen >/dev/null 2>&1; then
		script_id=$(uuidgen | tr -d '-')
	else
		script_id="$(date +%s)-$$"
	fi

	cell_script="/tmp/cellmgr-apply-${script_id}.sh"
	host_script="${ROOT_DIR}${cell_script}"
	stdin_tmp=

	cleanup_apply() {
		rm -f "${host_script}"
		if [ -n "${stdin_tmp}" ]; then
			rm -f "${stdin_tmp}"
		fi
	}
	trap cleanup_apply EXIT INT TERM HUP

	if [ "${script_source}" = "-" ]; then
		stdin_tmp=$(mktemp /tmp/cellmgr-apply-stdin.XXXXXX)
		cat > "${stdin_tmp}"
		if [ ! -s "${stdin_tmp}" ]; then
			echo "apply: stdin script is empty" >&2
			exit 1
		fi
		cp "${stdin_tmp}" "${host_script}"
	else
		cp "${script_source}" "${host_script}"
	fi
	chmod 700 "${host_script}"

	set -- cellctl exec "${cell_jid}" /bin/sh "${cell_script}" "$@"
	if "$@"; then
		apply_rc=0
	else
		apply_rc=$?
	fi

	stop_rc=0
	if [ "${ephemeral}" = "YES" ] && [ "${started_by_apply}" = "YES" ]; then
		if ! stop_cell "${name}"; then
			stop_rc=$?
		fi
	fi

	if [ "${apply_rc}" -ne 0 ]; then
		return "${apply_rc}"
	fi
	return "${stop_rc}"
}

restart_cell() {
	name=$1

	stop_cell "${name}"
	start_cell "${name}"
}

restart_all() {
	stop_all
	start_all
}

edit_cell_config() {
	name=$1
	load_cell_conf "${name}"
	editor=${VISUAL:-${EDITOR:-vi}}
	"${editor}" "${CELL_CONF}"
}

# Operational snapshot that combines kernel cell table output with mount view
# so operators can correlate runtime and filesystem state quickly.
status() {
	cellctl list || true
	echo
	mount | awk -v p="${CELL_DATA_DIR}/" 'index($0,p){print}'
}

list_cells() {
	printf '%-20s %-36s %-30s %-10s\n' 'NAME' 'ROOT' 'SUPERVISE_CMD' 'AUTOSTART'
	for cell_conf in "${CELL_DATA_DIR}"/*/cell.conf; do
		[ -f "${cell_conf}" ] || continue
		name=${cell_conf%/cell.conf}
		name=${name##*/}
		load_cell_conf "${name}"
		printf '%-20s %-36s %-30s %-10s\n' \
			"${name}" "${CELL_DATA_DIR}/${name}/root" \
			"${CELL_SUPERVISE_CMD:-}" "${CELL_AUTOSTART:-NO}"
	done
}

cmd=${1:-}
case "${cmd}" in
	bootstrap)
		ensure_rc_conf_entry
		ensure_secmodel_cell
		write_default_conf
		fetch_sets
		build_base
		;;
	create)
		autostart=NO
		supervise_cmd="/bin/sleep 60"
		create_profile=
		create_reserved_ports=
		supervise_facility=
		supervise_stdout_level=
		supervise_stderr_level=
		supervise_tag=
		shift
		while [ $# -gt 0 ]; do
			case "$1" in
			-a)
				autostart=YES
				shift
				;;
			-x)
				[ $# -ge 2 ] || { usage; exit 1; }
				supervise_cmd=$2
				shift 2
				;;
			-l)
				[ $# -ge 2 ] || { usage; exit 1; }
				create_profile=$2
				shift 2
				;;
			-r)
				[ $# -ge 2 ] || { usage; exit 1; }
				create_reserved_ports=$2
				shift 2
				;;
			-f)
				[ $# -ge 2 ] || { usage; exit 1; }
				supervise_facility=$2
				shift 2
				;;
			-o)
				[ $# -ge 2 ] || { usage; exit 1; }
				supervise_stdout_level=$2
				shift 2
				;;
			-e)
				[ $# -ge 2 ] || { usage; exit 1; }
				supervise_stderr_level=$2
				shift 2
				;;
			-t)
				[ $# -ge 2 ] || { usage; exit 1; }
				supervise_tag=$2
				shift 2
				;;
			-*)
				usage
				exit 1
				;;
			*)
				break
				;;
			esac
		done
		if [ $# -ne 1 ]; then
			usage
			exit 1
		fi
		name=$1
		create_cell "${name}" "${autostart}" "${supervise_cmd}" \
		    "${create_profile}" \
		    "${create_reserved_ports}" \
		    "${supervise_facility}" "${supervise_stdout_level}" \
		    "${supervise_stderr_level}" "${supervise_tag}"
		;;
	start)
		if [ $# -eq 2 ] && [ "$2" = "--all" ]; then
			start_all
		elif [ $# -eq 2 ]; then
			start_cell "$2"
		else
			usage
			exit 1
		fi
		;;
	stop)
		if [ $# -eq 2 ] && [ "$2" = "--all" ]; then
			stop_all
		elif [ $# -eq 2 ]; then
			stop_cell "$2"
		else
			usage
			exit 1
		fi
		;;
	restart)
		if [ $# -eq 2 ] && [ "$2" = "--all" ]; then
			restart_all
		elif [ $# -eq 2 ]; then
			restart_cell "$2"
		else
			usage
			exit 1
		fi
		;;
	apply)
		shift
		apply_cell_script "$@"
		;;
	config)
		if [ $# -eq 2 ]; then
			edit_cell_config "$2"
		else
			usage
			exit 1
		fi
		;;
	status)
		status
		;;
	list)
		list_cells
		;;
	*)
		usage
		exit 1
		;;
esac
