CELL_NAME=php-api-app-phpfpm
CELL_AUTOSTART=YES

CELL_CREATE_PROFILE="medium"
CELL_CREATE_RESERVED_PORTS="9000"

CELL_SUPERVISE_FACILITY="local3"
CELL_SUPERVISE_STDOUT_LEVEL="info"
CELL_SUPERVISE_STDERR_LEVEL="err"
CELL_SUPERVISE_TAG="cell-php-api-app-phpfpm"
CELL_SUPERVISE_CMD="/usr/pkg/sbin/php-fpm83 --nodaemonize --fpm-config /usr/pkg/etc/php-fpm-cellmgr.conf"

CELL_DEPENDS_ON=""
CELL_HEALTHCHECK_CMD="test -f /usr/pkg/etc/php-fpm-cellmgr.conf"
CELL_VOLUME_MOUNTS="php-api-webroot:/var/www/php-api:rw"
