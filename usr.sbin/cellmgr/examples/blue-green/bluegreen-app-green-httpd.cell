CELL_NAME=bluegreen-app-green-httpd
CELL_AUTOSTART=YES

CELL_CREATE_PROFILE="medium"
CELL_CREATE_RESERVED_PORTS="8081"

CELL_SUPERVISE_FACILITY="local5"
CELL_SUPERVISE_STDOUT_LEVEL="info"
CELL_SUPERVISE_STDERR_LEVEL="err"
CELL_SUPERVISE_TAG="cell-bluegreen-app-green-httpd"
CELL_SUPERVISE_CMD="/usr/libexec/httpd -I 8081 -X -f -s /var/www/bluegreen-green"

CELL_DEPENDS_ON=""
CELL_HEALTHCHECK_CMD="test -f /var/www/bluegreen-green/index.html"
